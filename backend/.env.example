# 이 파일을 .env로 복사한 뒤 실제 Hugging Face 토큰을 입력하세요.
HF_TOKEN=
HF_URL=https://router.huggingface.co/v1/chat/completions
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Retry transient failures while Render/Hugging Face wakes up.
AI_REQUEST_TIMEOUT=60
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY_SECONDS=2

# 배포된 프론트엔드 주소가 생기면 해당 Origin으로 변경하세요.
FRONTEND_ORIGINS=*
